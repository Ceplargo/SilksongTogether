<Project Sdk="Microsoft.NET.Sdk">

    <!-- The boss rule and spectating, an SSMP add-on. Ships in the release zip next to SSMP. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Version>0.1.0</Version>
        <!-- a release build names no folder of this PC (its debug file's path named the build's folder), as SSMP's -->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=source</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" PrivateAssets="all"/>
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" PrivateAssets="all"/>
        <!-- The version SSMP's packages.lock.json resolves. -->
        <PackageReference Include="Silksong.GameLibs" Version="1.2.0-silksong1.0.30000" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="SSMP">
            <HintPath>..\SSMP\bin\Release\netstandard2.1\SSMP.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
